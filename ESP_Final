// ---- Encoders ----
// Read and count for encoder (ref. 48)
// Update encoder speed
void updateEncoderSpeed() {
  unsigned long now = millis();
  if (now - lastSpeedCalc >= 500) {
    long count = encoderCount;
    long delta = count - lastCount;
    float revs = delta / ENCODER_PPR;
    currentRPM = revs / ((now - lastSpeedCalc) / 60000.0);
    Serial.printf("Encoder count: %ld  RPM: %.1f\n", count, currentRPM);
    lastCount = count;
    lastSpeedCalc = now;
  }
}

void IRAM_ATTR encoderISR() { 
  encoderCount++; 
}

// encoder speed
void updateEncoderSpeed() { 
  unsigned long now = millis(); 
  if (now - lastSpeedCalc >= 500) { 
    long count = encoderCount; 
    long delta = count - lastCount; 
    float elapsedMinutes = (now - lastSpeedCalc) / 60000.0f; 
    float revolutions = delta / ENCODER_PPR; 
    if (elapsedMinutes > 0.0f) { 
      currentRPM = revolutions / elapsedMinutes; 
    } 
    Serial.print("Encoder count: "); 
    Serial.print(count); 
    Serial.print(" | RPM: "); 
    Serial.println(currentRPM, 1); 
    lastCount = count; 
    lastSpeedCalc = now; 
  } 
}



// ---- Safety ----
// Estop
// Made so starts in estop, start by pushing restart button
volatile bool eStopped = true;
// heartbeat saftety?

void eStop() {
  eStopped = true;
  stopMotors();
  Serial.println("EMERGENCY STOP ACTIVATED");
  // digitalWrite(BUTTON_OFF, LOW); use if does'nt push back down
  servo1.detach();
  servo2.detach();
  // center steering
  setServoAngles(90.0f, 90.0f);
  // forget last drive command
  currentCommand.speed = 0;
}

// Restart
void restart() {
  Serial.println("Restarting...");
  // digitalWrite(BUTTON_ON, LOW); use if does'nt push back down
  delay(1);
  servo1.attach(s1);
  servo2.attach(s2);
  eStopped = false;
  currentCommand.speed = 0;
  setServoAngles(90.0f, 90.0f);
  stopMotors(); // starts based on next rasp pi command
  lastPiCommandTime = millis(); // reset coms
} 



