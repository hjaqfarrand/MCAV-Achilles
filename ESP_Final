// Turn all motors off
void stopMotors() {
  ledcWrite(in1, 0);
  ledcWrite(in2, 0);
  ledcWrite(in3, 0);
  ledcWrite(in4, 0);
}

// Move vehicle forward
void moveForward(int speed) { 
  speed = constrain(speed, 0, MAX_SPEED); 
  ledcWrite(MOTOR_1, speed); 
  ledcWrite(MOTOR_2, 0); 
  ledcWrite(MOTOR_3, speed); 
  ledcWrite(MOTOR_4, 0); 
}

// Drive backwards
void moveBackward(int speed) { 
  speed = constrain(speed, 0, MAX_SPEED); 
  ledcWrite(MOTOR_1, 0); 
  ledcWrite(MOTOR_2, speed); 
  ledcWrite(MOTOR_3, 0); 
  ledcWrite(MOTOR_4, speed); 
}

// Set the motor speed from rp
void set_speed(int speed) { 
  speed = constrain(speed, -MAX_SPEED, MAX_SPEED); 
  if (speed > 0) { 
    moveForward(speed); 
  } else if (speed < 0) { 
    moveBackward(-speed); 
  } else { stopMotors(); } 
}

// ---- Servo Movement ----
void setServoAngles(float frontAngle, float rearAngle) { 
  frontAngle = constrain(frontAngle, 0.0f, 180.0f); 
  rearAngle = constrain(rearAngle, 0.0f, 180.0f); 
  frontServo.write((int)frontAngle); 
  rearServo.write((int)rearAngle); 
}



// ---- Raspberry Pi ----
// Read from raspeberry pi
// rp needs to send in form message = f"{speed},{front_angle},{rear_angle}\n"
// decide on output
// recieve drive speed to DRIVE_SPEED
// front wheel speed, rear wheel speed, front wheel angle, rear wheel angle
// expect: speed,frontAngle,rearAngle

// command parser
bool parsePiCommand(const String &line) { 
  float speed; 
  float frontAngle; 
  float rearAngle; 
  int firstComma = line.indexOf(','); 
  int secondComma = line.indexOf(',', firstComma + 1); 
  if (firstComma < 0 || secondComma < 0) { 
    return false; 
  } 
  String speedString = line.substring(0, firstComma); 
  String frontString = line.substring(firstComma + 1, secondComma); 
  String rearString = line.substring(secondComma + 1); 
  speed = speedString.toFloat(); 
  frontAngle = frontString.toFloat(); 
  rearAngle = rearString.toFloat(); 
  // Check ranges
  if (speed < -255.0f || speed > 255.0f) { 
    return false; 
  } 
  if (frontAngle < 0.0f || frontAngle > 180.0f) { 
    return false; 
  } 
  if (rearAngle < 0.0f || rearAngle > 180.0f) { 
    return false; 
  } 
  currentCommand.speed = (int)speed; 
  currentCommand.frontAngle = frontAngle; 
  currentCommand.rearAngle = rearAngle; 
  lastPiCommandTime = millis(); 
  return true; }

// Read raspberry pi 
void readRaspberryPi() { 
  while (PiSerial.available()) { 
    char c = PiSerial.read(); 
    // End of command
    if (c == '\n' || c == '\r') { 
      if (piInputBuffer.length() > 0) { 
        if (parsePiCommand(piInputBuffer)) { 
          Serial.print("Pi command: speed="); 
          Serial.print(currentCommand.speed); 
          Serial.print(" front="); 
          Serial.print(currentCommand.frontAngle); 
          Serial.print(" rear="); 
          Serial.println(currentCommand.rearAngle); 
        } else { 
          Serial.print("Invalid Pi command: "); 
          Serial.println(piInputBuffer); 
        } 
        piInputBuffer = ""; 
      } 
    } else { 
      // Prevent runaway buffer growth
      if (piInputBuffer.length() < 100) { 
        piInputBuffer += c; 
      } else { 
        piInputBuffer = ""; 
      } 
    } 
  } 
}



// ---- Apply commands to vehicle ----
void applyVehicleCommand() { 
  // Wireless e-stop has priority 
  if (eStopped) { stopMotors(); return; } 
  // Raspberry Pi communication timeout
  if (millis() - lastPiCommandTime > PI_TIMEOUT_MS) { 
    stopMotors(); return; 
  } // Steering
  setServoAngles( currentCommand.frontAngle, currentCommand.rearAngle ); 
  // Drive
  setMotorSpeed(currentCommand.speed); 
}



