void emergencyStop()
{
    eStopped = true;
    // Immediately remove motor PWM
    stopMotors();
    // Reset commanded speed
    currentCommand.frontWheelSpeed = 0;
    currentCommand.rearWheelSpeed = 0;
    Serial.println(
        "EMERGENCY STOP"
    );
    PiSerial.println(
        "STATUS,ESTOP"
    );
}

void restartSystem()
{
    eStopped = false;
    currentCommand.frontWheelSpeed = 0;
    currentCommand.rearWheelSpeed = 0;
    Serial.println(
        "SYSTEM READY"
    );
    PiSerial.println(
        "STATUS,READY"
    );
}

void setServoAngles(float frontAngle,float rearAngle)
{
    frontAngle = constrain(frontAngle,0,180);
    rearAngle = constrain(rearAngle,0,180);
        
    frontServo.write(frontAngle);
    rearServo.write(rearAngle);
}

//loop
void loop()
{
    // Emergency stop has highest priority
    checkRadio();
    // Receive Pi command
    readRaspberryPi();
    // Drive motors
    setMotorSpeed(
        currentCommand.frontWheelSpeed,
        currentCommand.rearWheelSpeed
    );
    // Steering
    setServoAngles(
        currentCommand.frontWheelAngle,
        currentCommand.rearWheelAngle
    );
    // Send encoder feedback
    sendOdometry();
}
