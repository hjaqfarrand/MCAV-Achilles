void readRaspberryPi() { 
  while (PiSerial.available()) { 
    char c = PiSerial.read(); 
    // End of command
    if (c == '\n' || c == '\r') { 
      if (piInputBuffer.length() > 0) { 
        if (parsePiCommand(piInputBuffer)) { 
          Serial.print("Pi command: speed="); 
          Serial.print(currentCommand.speed); 
          Serial.print(" front="); 
          Serial.print(currentCommand.frontAngle); 
          Serial.print(" rear="); 
          Serial.println(currentCommand.rearAngle); 
        } else { 
          Serial.print("Invalid Pi command: "); 
          Serial.println(piInputBuffer); 
        } 
        piInputBuffer = ""; 
      } 
    } else { 
      // Prevent runaway buffer growth
      if (piInputBuffer.length() < 100) { 
        piInputBuffer += c; 
      } else { 
        piInputBuffer = ""; 
      } 
    } 
  } 
}


void sendOdometry()
{
    unsigned long currentTime = millis();
    if(currentTime - lastOdomTime < 29)
    {
        return;
    }
    unsigned long elapsedTime =
        currentTime - lastOdomTime;
    lastOdomTime = currentTime;
    // Read encoder values
    long count1;
    long count2;

    noInterrupts();

    count1 = encoderCount1;
    count2 = encoderCount2;

    interrupts();

    // Calculate RPM
    long delta1 = count1 - previousCount1;
    long delta2 = count2 - previousCount2;
    rpm1 =
        (delta1 / ENCODER_PPR) *
        (60000.0 / elapsedTime);
    rpm2 =
        (delta2 / ENCODER_PPR) *
        (60000.0 / elapsedTime);
    previousCount1 = count1;
    previousCount2 = count2;

    // Send one complete packet
    PiSerial.printf("ODOM,%ld,%ld,%.2f,%.2f,%.2f,%.2f\n",count1,count2,rpm1,rpm2,currentCommand.frontWheelAngle,currentCommand.rearWheelAngle);
}

void checkRadio()
{
  if(radio.available())
  {
    uint8_t command;
    radio.read(&command,sizeof(command));
    Serial.print("nRF command: ");
    Serial.println(command);
      if(command == CMD_ESTOP)
        {
          emergencyStop();
        }
        else if(command == CMD_RESTART)
        {
          restartSystem();
        }
    }
}

