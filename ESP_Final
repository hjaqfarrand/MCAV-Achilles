// ---- Radio ----
void checkRadio() { 
  while (radio.available()) { 
    uint8_t receivedCommand = 0; 
    radio.read( &receivedCommand, sizeof(receivedCommand) ); 
    Serial.print("nRF command: 0x"); 
    Serial.println(receivedCommand, HEX); 
    if (receivedCommand == CMD_ESTOP) { 
      eStop(); 
    } else if (receivedCommand == CMD_RESTART) { 
      restartSystem(); 
    } 
  } 
}




// ---------- Set up ----------
void setup() {
  Serial.begin(115200);

  delay(500);

  Serial.printIn();
  Serial.printIn("ESP32 Car Controls Starting...");
  Serial.printIn();

  SPI.begin(SCK, MISO, MOSI, CSN);

  // Motor PWM
  ledcAttach(in1, PWM_FREQ, PWM_RES);
  ledcAttach(in2, PWM_FREQ, PWM_RES);
  ledcAttach(in3, PWM_FREQ, PWM_RES);
  ledcAttach(in4, PWM_FREQ, PWM_RES);

  stopMotors();


  // Servos
  s1.setPeriodHertz(50);
  s2.setPeriodHertz(50);
  servo1.attach(s1);
  servo2.attach(s2);
  setServoAngles(90.0f, 90.0f);


  // Encoders
  pinMode(A1, INPUT_PULLUP);
  pinMode(A2, OUTPUT);
  pinMode(B1, INPUT);
  pinMode(B2, OUTPUT);
  attachInterrupt( 
    digitalPinToInterrupt(A1), 
    encoderISR, 
    CHANGE 
  );


  // rp UART2
  PiSerial.begin( 
    PI_BAUD, 
    SERIAL_8N1, 
    PI_RX, PI_TX 
  ); 
  Serial.println("UART2 initialized."); 
  Serial.print("Pi RX = GPIO "); 
  Serial.println(piRX); 
  Serial.print("Pi TX = GPIO "); 
  Serial.println(piTX);


  // radio
  if (!radio.begin()) {
    Serial.println("nRF24 not responding — check wiring!");
    stopMotors();
    while (true) { 
      delay(1000); 
    }
  }

  radio.setPALevel(RF24_PA_LOW);
  radio.setDataRate(RF24_1MBPS);
  radio.setChannel(76);
  radio.openReadingPipe(1, address);
  radio.startListening();

  Serial.println("Receiver ready — moving until e-stop is received...");


  // starting safety
  eStopped = true; 
  stopMotors(); 
  lastPiCommandTime = millis(); 
  Serial.println(); 
  Serial.println("Vehicle is ready!"); 
  Serial.println("System is eStopped"); 
  Serial.println("Send command to restart movement");
}





// ---------- Main loop ----------
void loop() {
   
  checkRadio();

  readRaspberryPi();

  car_command();

  updateEncoderSpeed();

}
