// ---------- Includes, variables and values ----------
#include <Arduino.h>
#include <SPI.h>
#include <RF24.h>
#include <nRF24L01.h>
#include <ESP32Servo.h>
#include <math.h>
#include <stdio.h>

// Time
#include <iostream>
#include <chrono>
#include <thread>

// Math
#define _USE_MATH_DEFINES
#include <math.h>
# define M_PI 3.14159265358979323846

// ---------- Pin outs ----------
// NRF24L01
// nRF24L01
#define CE 25
#define IRQ 13
#define CSN 26
#define SCK 27
#define MOSI 14
#define MISO 12

// DRV8833
#define IN1 21
#define IN2 19
#define IN3 18
#define IN4 5

#define PWM_FREQ 5000
#define PWM_RES 8

// Raspberry Pi UART
// GPIO 17 (TX2) and GPIO 16 (RX2) avoid USB Serial (GPIO 1/3) conflicts
// so i dont have to pull out the pins every time i flash the esp
#define TX 17
#define RX 16

// Encoder 1 - Front
#define A1 34
#define B1 35

// Encoder 2 - Rear
#define A2 32
#define B2 33

// Servos
#define s1 2
#define s2  4

#define FRONT_NEUTRAL 45
#define REAR_NEUTRAL  90

// ---------- Other definitions ----------


// Servos
Servo servo1;
Servo servo2;



// ---------- Set up ----------
void setup() {
  Serial.begin(115200);

  SPI.begin(SCK, MISO, MOSI, CSN);

  ledcAttach(IN1, PWM_FREQ, PWM_RES);
  ledcAttach(IN2, PWM_FREQ, PWM_RES);
  ledcAttach(IN3, PWM_FREQ, PWM_RES);
  ledcAttach(IN4, PWM_FREQ, PWM_RES);

  servo1.attach(s1);
  servo2.attach(s2);

  pinMode(A1, INPUT);
  pinMode(A2, OUTPUT);
  pinMode(B1, INPUT);
  pinMode(B2, OUTPUT);

}



// ---------- Funtions ----------



// ---- Movement ----
// Turn all motors off
void stopMotors() {
  ledcWrite(IN1, 0);
  ledcWrite(IN2, 0);
  ledcWrite(IN3, 0);
  ledcWrite(IN4, 0);
}
// Move vehicle forward




// ---------- Main loop ----------
void loop() {


  ledcWrite(IN1, 255);
  ledcWrite(IN2, 255);
  ledcWrite(IN3, 255);
  ledcWrite(IN4, 255);
}


