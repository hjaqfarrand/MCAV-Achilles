// ---------- Set up ----------
void setup() {
  Serial.begin(115200);

  SPI.begin(SCK, MISO, MOSI, CSN);

  ledcAttach(in1, PWM_FREQ, PWM_RES);
  ledcAttach(in2, PWM_FREQ, PWM_RES);
  ledcAttach(in3, PWM_FREQ, PWM_RES);
  ledcAttach(in4, PWM_FREQ, PWM_RES);

  servo1.attach(s1);
  servo2.attach(s2);

  pinMode(A1, INPUT);
  pinMode(A2, OUTPUT);
  pinMode(B1, INPUT);
  pinMode(B2, OUTPUT);

  // change this!!!!
  attachInterrupt(digitalPinToInterrupt(A1), encoderISR, CHANGE);

  if (!radio.begin()) {
    Serial.println("nRF24 not responding — check wiring!");
    while (1) {}
  }

  radio.setPALevel(RF24_PA_LOW);
  radio.setDataRate(RF24_1MBPS);
  radio.setChannel(76);
  radio.openReadingPipe(1, address);
  radio.startListening();

  Serial.println("Receiver ready — moving until e-stop is received...");
}



// ---------- Funtions ----------

// ---- Encoders ----
// Read and count for encoder (ref. 48)
// Update encoder speed
void updateEncoderSpeed() {
  unsigned long now = millis();
  if (now - lastSpeedCalc >= 500) {
    long count = encoderCount;
    long delta = count - lastCount;
    float revs = delta / ENCODER_PPR;
    currentRPM = revs / ((now - lastSpeedCalc) / 60000.0);
    Serial.printf("Encoder count: %ld  RPM: %.1f\n", count, currentRPM);
    lastCount = count;
    lastSpeedCalc = now;
  }
}

// ---- Safety ----
// Estop
void eStop() {
  Serial.println("EMERGENCY STOP ACTIVATED");
  stopMotors();
  // digitalWrite(BUTTON_OFF, LOW); use if does'nt push back down
  servo1.detach();
  servo2.detach();
  eStopped = true;
}
// Restart
void restart() {
  Serial.println("Restarting...");
  // digitalWrite(BUTTON_ON, LOW); use if does'nt push back down
  delay(1);
  servo1.attach(s1);
  servo2.attach(s2);
  eStopped = false;
} 


// ---- Movement ----
// Turn all motors off
void stopMotors() {
  ledcWrite(in1, 0);
  ledcWrite(in2, 0);
  ledcWrite(in3, 0);
  ledcWrite(in4, 0);
}
// Move vehicle forward
int moveForward(DRIVE_SPEED) {
  ledcWrite(in1, DRIVE_SPEED);
  ledcWrite(in2, 0);
  ledcWrite(in3, DRIVE_SPEED);
  ledcWrite(in4, 0);
}


