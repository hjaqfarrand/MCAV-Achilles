#include <Wire.h>
#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>
#include <ESP32Servo.h>

#define CE 19      // NRF24L01
#define CSN 18     // NRF24L01
#define SCK 17     // NRF24L01
#define MISO 22    // NRF24L01
#define MOSI 16    // NRF24L01
#define IRQ 23     // NRF24L01

#define M1IN1 33   // IN1
#define M1IN2 25   // IN2
#define M2IN1 26   // IN3
#define M2IN2 27   // IN4
#define SLEEP 32

#define S1         // Servo 1
#define S2         // Servo 2
Servo servo1;
Servo servo2;

RF24 radio(CE, CSN); // CE, CSN
const byte address[6] = "00001";
const byte BTN_MSG    = 0xAB;   // value the transmitter sends on button press

void setup() {
  Serial.begin(115200);

  SPI.begin(SCK, MISO, MOSI, CSN); // SCK, MISO, MOSI, CSN

  pinMode(M1IN1, OUTPUT);
  pinMode(M1IN2, OUTPUT);
  pinMode(M2IN1, OUTPUT);
  pinMode(M2IN2, OUTPUT);
  pinMode(SLEEP, OUTPUT);
  digitalWrite(SLEEP, HIGH);

  servo1.attach(S1);
  servo2.attach(S2);

  if (!radio.begin()) {
    Serial.println("nRF24 not responding — check wiring!");
    while (1) {}
  }

  radio.setPALevel(RF24_PA_LOW);
  radio.setDataRate(RF24_1MBPS);
  radio.setChannel(76);          // must match transmitter
  radio.openReadingPipe(1, address);
  radio.startListening();

  Serial.println("Receiver ready — listening for button presses...");
}

