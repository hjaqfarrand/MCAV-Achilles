void restart() {
  digitalWrite(SLEEP, HIGH);
  delay(1);
  servo1.attach(S1);
  servo2.attach(S2);
}

// Movement
void moveForward(){
  analogWrite(M1IN1, 128);
  digitalWrite(M1IN2, LOW);

  analogWrite(M2IN1, 128);
  digitalWrite(M2IN2, LOW);
}

void moveBackward(){
  analogWrite(M1IN1, LOW);
  digitalWrite(M1IN2, 128);

  analogWrite(M2IN1, LOW);
  digitalWrite(M2IN2, 128);
}

