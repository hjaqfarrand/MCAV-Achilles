#include <Wire.h>
#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>
#include <ESP32Servo.h>

#define CE 19      // NRF24L01
#define CSN 18     // NRF24L01
#define SCK 17     // NRF24L01
#define MISO 22    // NRF24L01
#define MOSI 16    // NRF24L01
#define IRQ 23     // NRF24L01

#define M1IN1 33   // IN1
#define M1IN2 25   // IN2
#define M2IN1 26   // IN3
#define M2IN2 27   // IN4
#define BUTTON_OFF 32  // activates estop
#define BUTTON_ON 12   // restarts vehicle

#define S1 14       // Servo 1
#define S2 15       // Servo 2
Servo servo1;
Servo servo2;

// ---- Encoder ----
#define ENCODER_A 21   // Green wire — interrupt pin
#define ENCODER_B 4    // Blue wire — direction pin

const float ENCODER_PPR = 990.0;

volatile long encoderCount = 0;
unsigned long lastSpeedCalc = 0;
long lastCount = 0;
float currentRPM = 0;

void IRAM_ATTR encoderISR() {
  bool a = digitalRead(ENCODER_A);
  bool b = digitalRead(ENCODER_B);
  if (a == b) encoderCount++;
  else encoderCount--;
}

RF24 radio(CE, CSN); // CE, CSN
const byte address[6] = "00001";

// Command protocol — only e-stop / restart matter now
enum Command : byte {
  CMD_ESTOP    = 0xAB,
  CMD_RESTART  = 0xAC
};

// start off so we can press button to begin first
bool eStopped = true;

// PWM setup (v3.0+ API)
#define PWM_FREQ 5000
#define PWM_RES  8
#define DRIVE_SPEED 128   // constant forward speed

void setup() {
  Serial.begin(115200);

  SPI.begin(SCK, MISO, MOSI, CSN);

  ledcAttach(M1IN1, PWM_FREQ, PWM_RES);
  ledcAttach(M1IN2, PWM_FREQ, PWM_RES);
  ledcAttach(M2IN1, PWM_FREQ, PWM_RES);
  ledcAttach(M2IN2, PWM_FREQ, PWM_RES);

  pinMode(BUTTON_OFF, INPUT);
  pinMode(BUTTON_ON, INPUT);

  servo1.attach(S1);
  servo2.attach(S2);

  pinMode(ENCODER_A, INPUT);
  pinMode(ENCODER_B, INPUT);
  attachInterrupt(digitalPinToInterrupt(ENCODER_A), encoderISR, CHANGE);

  if (!radio.begin()) {
    Serial.println("nRF24 not responding — check wiring!");
    while (1) {}
  }

  radio.setPALevel(RF24_PA_LOW);
  radio.setDataRate(RF24_1MBPS);
  radio.setChannel(76);
  radio.openReadingPipe(1, address);
  radio.startListening();

  Serial.println("Receiver ready — moving until e-stop is received...");
}

// ---- Safety ----
void eStop() {
  Serial.println("EMERGENCY STOP ACTIVATED");
  stopMotors();
  // digitalWrite(BUTTON_OFF, LOW); use if does'nt push back down
  servo1.detach();
  servo2.detach();
  eStopped = true;
}

void restart() {
  Serial.println("Restarting...");
  // digitalWrite(BUTTON_ON, LOW); use if does'nt push back down
  delay(1);
  servo1.attach(S1);
  servo2.attach(S2);
  eStopped = false;
}

// ---- Movement ----
void stopMotors() {
  ledcWrite(M1IN1, 0);
  ledcWrite(M1IN2, 0);
  ledcWrite(M2IN1, 0);
  ledcWrite(M2IN2, 0);
}

void moveForward() {
  ledcWrite(M1IN1, DRIVE_SPEED);
  ledcWrite(M1IN2, 0);
  ledcWrite(M2IN1, DRIVE_SPEED);
  ledcWrite(M2IN2, 0);
}

// ---- Encoder speed calc ----
void updateEncoderSpeed() {
  unsigned long now = millis();
  if (now - lastSpeedCalc >= 500) {
    long count = encoderCount;
    long delta = count - lastCount;
    float revs = delta / ENCODER_PPR;
    currentRPM = revs / ((now - lastSpeedCalc) / 60000.0);
    Serial.printf("Encoder count: %ld  RPM: %.1f\n", count, currentRPM);
    lastCount = count;
    lastSpeedCalc = now;
  }
}

// ---- Main loop ----
void loop() {
  if (radio.available()) {
    byte received = 0;
    radio.read(&received, sizeof(received));

    Serial.print("Received: 0x");
    Serial.println(received, HEX);

    if (received == CMD_ESTOP) {
      eStop();
    } else if (received == CMD_RESTART) {
      restart();
    }
  }

  if (digitalRead(BUTTON_OFF) == HIGH) {
    eStop();
  }

// made else if so must be pressing the one only, failsafe
  else if (digitalRead(BUTTON_ON) == HIGH) {
    restart();
  }

  updateEncoderSpeed();

  }

